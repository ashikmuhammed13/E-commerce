<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Returns - Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css">
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #1e2a35;
            color: #ffffff;
            margin: 0;
            padding: 0;
        }
        .sidebar {
            width: 250px;
            background-color: #1e2a35;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            overflow-y: auto;
            transition: all 0.3s;
            z-index: 1000;
            padding-top: 20px;
        }
        .sidebar-logo {
            padding: 0 15px 20px;
            border-bottom: 1px solid #3a4557;
        }
        .sidebar-logo img {
            max-width: 100%;
            height: auto;
        }
        .nav-link {
            color: #8391a2;
            padding: 10px 15px;
            transition: 0.3s;
        }
        .nav-link:hover, .nav-link.active {
            color: #ffffff;
            background-color: #1e2130;
        }
        .nav-link i {
            margin-right: 10px;
            width: 20px;
        }
        .main-content {
            margin-left: 250px;
            padding: 20px;
            transition: all 0.3s;
        }
        .navbar {
            background-color: #262b3c;
            padding: 10px 20px;
        }
        .search-form {
            flex-grow: 1;
            max-width: 400px;
        }
        .search-form .form-control {
            background-color: #1e2a35;
            border: none;
            color: #ffffff;
            padding-left: 40px;
        }
        .search-form .form-control::placeholder {
            color: #8391a2;
        }
        .search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #8391a2;
        }
        .navbar-nav .nav-link {
            padding: 0 10px;
        }
        .card {
            background-color: #262b3c;
            border: none;
            border-radius: 5px;
            margin-bottom: 20px;
        }
        .card-header {
            background-color: #1e2130;
            border-bottom: 1px solid #3a4557;
            color: #ffffff;
        }
        .btn-primary {
            background-color: #624bff;
            border-color: #624bff;
        }
        .btn-secondary {
            background-color: #2c3144;
            color: white;
            border: none;
        }
        .table {
            color: #ffffff;
            background-color: #262b3c;
        }
        .table th {
            background-color: #1e2130;
            border-color: #3a4557 !important;
        }
        .table td {
            border-color: #3a4557 !important;
        }
        .status-badge {
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 0.8em;
        }
        .status-pending { background-color: #ffa60033; color: #ffa600; }
        .status-processing { background-color: #00cfe833; color: #00cfe8; }
        .status-refunded { background-color: #28c76f33; color: #28c76f; }
        .status-requested { background-color: #624bff33; color: #624bff; }
        .controls {
            margin-bottom: 20px;
        }
        .controls > * {
            margin-right: 10px;
            margin-bottom: 10px;
        }
        @media (max-width: 768px) {
            .sidebar {
                width: 60px;
            }
            .main-content {
                margin-left: 60px;
            }
            .sidebar .nav-link span {
                display: none;
            }
            .sidebar-logo {
                text-align: center;
                padding: 10px 0;
            }
            .sidebar-logo img {
                max-width: 40px;
            }
            .card-body {
                padding: 0.5rem;
            }
            .table-responsive {
                font-size: 0.875rem;
            }
        }
    </style>
</head>
<body>
    {{>adminSidebar}}

    <div class="main-content">
        <nav class="navbar navbar-expand-lg navbar-dark mb-4">
            <div class="container-fluid">
                <form class="search-form position-relative">
                    <i class="fas fa-search search-icon"></i>
                    <input class="form-control" type="search" placeholder="Search Returns" aria-label="Search">
                </form>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="fas fa-moon"></i></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="fas fa-bell"></i></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#"><img src="https://via.placeholder.com/30" class="rounded-circle" alt="User"></a>
                    </li>
                </ul>
            </div>
        </nav>

        <div class="container">
            <h1 class="mb-4">Returns Management</h1>
            <div class="controls d-flex flex-wrap align-items-center">
                <select id="statusFilter" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="pending">Pending</option>
                    <option value="processing">Processing</option>
                    <option value="refunded">Refunded</option>
                    <option value="requested">Requested</option>
                </select>
                <button class="btn btn-secondary">Export</button>
            </div>
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Customer</th>
                                    <th>Product</th>
                                    <th>Return Status</th>
                                    <th>Total Amount</th>
                                    <th>Date Placed</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="returnTableBody">
                                {{#each orders}}
                                <tr>
                                    <td>{{this.orderID}}</td>
                                    <td>{{this.userId.username}}</td>
                                    <td>
                                        {{#each this.items}}
                                            {{#if this.isReturn}}
                                                {{this.product.name}} (x{{this.quantity}})<br>
                                            {{/if}}
                                        {{/each}}
                                    </td>
                                    <td>
                                        {{#each this.items}}
                                            {{#if this.isReturn}}
                                                <span class="status-badge status-{{this.isReturn}}">
                                                    {{this.isReturn}}
                                                </span><br>
                                            {{/if}}
                                        {{/each}}
                                    </td>
                                    <td>${{this.totalAmount}}</td>
                                    <td>{{this.datePlaced}}</td>
                                    <td>
                                        <select class="form-select form-select-sm return-status-select" data-order-id="{{this._id}}">
                                            <option value="pending" {{#if (eq this.items.[0].isReturn "pending")}}selected{{/if}}>Pending</option>
                                            <option value="processing" {{#if (eq this.items.[0].isReturn "processing")}}selected{{/if}}>Processing</option>
                                            <option value="refunded" {{#if (eq this.items.[0].isReturn "refunded")}}selected{{/if}}>Refunded</option>
                                            <option value="requested" {{#if (eq this.items.[0].isReturn "requested")}}selected{{/if}}>Requested</option>
                                        </select>
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const statusSelects = document.querySelectorAll('.return-status-select');
        const statusFilter = document.getElementById('statusFilter');

        statusSelects.forEach(select => {
            select.addEventListener('change', function() {
                const orderId = this.getAttribute('data-order-id');
                const newStatus = this.value;

                fetch('/admin/updateReturnStatus', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ orderId: orderId, status: newStatus })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        console.log('Return status updated successfully');
                        // Update UI as needed
                        const statusBadge = this.closest('tr').querySelector('.status-badge');
                        statusBadge.textContent = newStatus;
                        statusBadge.className = `status-badge status-${newStatus}`;
                    } else {
                        console.error('Error updating return status:', data.message);
                        alert('Error updating return status: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while updating the return status.');
                });
            });
        });

        statusFilter.addEventListener('change', function() {
            const selectedStatus = this.value;
            const rows = document.querySelectorAll('#returnTableBody tr');

            rows.forEach(row => {
                const statusBadge = row.querySelector('.status-badge');
                if (selectedStatus === '' || statusBadge.textContent.trim().toLowerCase() === selectedStatus) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    });
    </script>
</body>
</html>