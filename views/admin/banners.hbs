                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addBottomBannerModal">
                        <i class="fas fa-plus"></i> Add Bottom Banner
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Background</th>
                                <th>Title</th>
                                <th>Description</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each botBanners}}
                            <tr>
                                <td><img src="/uploads/{{this.bkimage}}" alt="Bottom Banner" class="banner-preview img-fluid"></td>
                                <td>{{this.title}}</td>
                                <td>{{this.dscrptext}}</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></button>
                                    <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Sale Banner Tab -->
            <div class="tab-pane fade" id="sale" role="tabpanel" aria-labelledby="sale-tab">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title mb-0">Sale Banners</h5>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addSaleBannerModal">
                        <i class="fas fa-plus"></i> Add Sale Banner
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Preview</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each saleBanners}}
