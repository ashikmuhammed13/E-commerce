<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Banner Management</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #1e2a35;
            color: #f0f2f5;
            margin: 0;
            padding: 0;
        }

        /* Main Content Styles */
        .main-content {
            margin-left: 250px;
            padding: 20px;
            transition: all 0.3s;
            background-color: #1e2a35;
            min-height: 100vh;
        }

        /* Navbar Styles */
        .navbar {
            background-color: #262b3c;
            padding: 10px 20px;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        .search-form {
            flex-grow: 1;
            max-width: 400px;
            position: relative;
        }

        .search-form .form-control {
            background-color: #1e2a35;
            border: none;
            color: #ffffff;
            padding-left: 40px;
        }

        .search-form .form-control::placeholder {
            color: #8391a2;
        }

        .search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #8391a2;
        }

        .navbar-nav .nav-link {
            padding: 0 10px;
            color: #8391a2;
        }

        .navbar-nav .nav-link:hover {
            color: #ffffff;
        }

        /* Button Styles */
        .btn-primary {
            background-color: #624bff;
            border-color: #624bff;
        }

        .btn-primary:hover {
            background-color: #4e73df;
            border-color: #4e73df;
        }

        .btn-outline-info {
            color: #8391a2;
            border-color: #3a4557;
        }

        .btn-outline-info:hover {
            color: #ffffff;
            background-color: #1e2130;
            border-color: #1e2130;
        }

        .btn-outline-warning {
            color: #f6c23e;
            border-color: #f6c23e;
        }

        .btn-outline-warning:hover {
            color: #ffffff;
            background-color: #f6c23e;
            border-color: #f6c23e;
        }

        /* Table Styles */
        .table {
            background-color: #262b3c;
            color: #f0f2f5;
        }

        .table th {
            background-color: #1e2130;
            border-color: #3a4557 !important;
            font-weight: 600;
        }

        .table td {
            border-color: #3a4557 !important;
        }

        .banner-preview {
            width: 100px;
            height: 60px;
            object-fit: cover;
            border-radius: 5px;
        }

        /* Card Styles */
        .card {
            background-color: #262b3c;
            border-color: #3a4557;
        }

        .card-body {
            color: #f0f2f5;
        }

        /* Tab Styles */
        .nav-tabs {
            border-bottom-color: #3a4557;
        }

        .nav-tabs .nav-link {
            color: #8391a2;
        }

        .nav-tabs .nav-link:hover,
        .nav-tabs .nav-link.active {
            color: #ffffff;
            background-color: #1e2130;
            border-color: #3a4557 #3a4557 #1e2130;
        }

        /* Modal Styles */
        .modal-content {
            background-color: #262b3c;
            color: #f0f2f5;
        }

        .modal-header {
            border-bottom-color: #3a4557;
        }

        .modal-footer {
            border-top-color: #3a4557;
        }

        /* Sidebar Styles */
        .sidebar {
            width: 250px;
            background-color: #1e2a35;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            overflow-y: auto;
            transition: all 0.3s;
            z-index: 1000;
            padding-top: 20px;
        }

        .sidebar-logo {
            padding: 0 15px 20px;
            border-bottom: 1px solid #3a4557;
        }

        .sidebar-logo img {
            max-width: 100%;
            height: auto;
        }

        .nav-link {
            color: #8391a2;
            padding: 10px 15px;
            transition: 0.3s;
        }

        .nav-link:hover,
        .nav-link.active {
            color: #ffffff;
            background-color: #1e2130;
        }

        .nav-link i {
            margin-right: 10px;
            width: 20px;
        }

        /* Responsive Styles */
        @media (max-width: 768px) {
            .sidebar {
                width: 60px;
            }

            .sidebar .nav-link span {
                display: none;
            }

            .sidebar-logo {
                text-align: center;
                padding: 10px 0;
            }

            .sidebar-logo img {
                max-width: 40px;
            }

            .main-content {
                margin-left: 60px;
            }

            .search-form {
                max-width: 200px;
            }

            .navbar-nav .nav-link i {
                margin-right: 0;
            }
        }
    </style>
</head>

