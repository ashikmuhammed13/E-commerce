                        <input type="file" class="form-control" id="bgimage" name="bgimage" required>
                    </div>
                    <div class="mb-3">
                        <label for="maintext" class="form-label">Main Text</label>
                        <input type="text" class="form-control" id="maintext" name="maintext" required>
                    </div>
                    <div class="mb-3">
                        <label for="bgtext" class="form-label">Background Text</label>
                        <input type="text" class="form-control" id="bgtext" name="bgtext" required>
                    </div>
                    <div class="mb-3">
