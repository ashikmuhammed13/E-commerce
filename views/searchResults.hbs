<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LUXE - Exquisite Search Results</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f9f7f5;
            color: #333;
        }
        .luxe-container {
            max-width: 1600px;
            margin: 0 auto;
            padding: 60px 40px;
        }
        .page-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 56px;
            color: #1a1a1a;
            text-align: center;
            margin-bottom: 50px;
            letter-spacing: 2px;
        }
        .filter-section {
            background-color: #fff;
            border-radius: 15px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
            padding: 40px;
            margin-bottom: 60px;
            border: 1px solid #e0d5c0;
        }
        .filter-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 32px;
            color: #1a1a1a;
            margin-bottom: 30px;
            letter-spacing: 1px;
            text-align: center;
            position: relative;
        }
        .filter-title::after {
            content: '';
            display: block;
            width: 60px;
            height: 2px;
            background-color: #b0935e;
            margin: 15px auto 0;
        }
        .filter-group {
            margin-bottom: 30px;
        }
        .filter-label {
            font-weight: 600;
            margin-bottom: 12px;
            display: block;
            color: #4a4a4a;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .form-select, .form-control {
            border: 1px solid #d4c1a8;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 14px;
            transition: all 0.3s ease;
            background-color: #fcfaf8;
        }
        .form-select:focus, .form-control:focus {
            border-color: #b0935e;
            box-shadow: 0 0 0 0.2rem rgba(176, 147, 94, 0.25);
            background-color: #fff;
        }
        .price-inputs {
            display: flex;
            gap: 15px;
        }
        .btn-filter {
            background-color: #b0935e;
            color: #fff;
            border: none;
            padding: 15px 30px;
            font-weight: 600;
            transition: all 0.3s ease;
            border-radius: 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
            width: 100%;
            font-size: 16px;
        }
        .btn-filter:hover {
            background-color: #96793e;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(176, 147, 94, 0.3);
        }
        .checkbox-group {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
        }
        .checkbox-group input[type="checkbox"] {
            margin-right: 10px;
            appearance: none;
            width: 20px;
            height: 20px;
            border: 1px solid #d4c1a8;
            border-radius: 4px;
            outline: none;
            transition: all 0.3s ease;
            position: relative;
            cursor: pointer;
        }
        .checkbox-group input[type="checkbox"]:checked {
            background-color: #b0935e;
            border-color: #b0935e;
        }
        .checkbox-group input[type="checkbox"]:checked::after {
            content: '\2714';
            font-size: 14px;
            color: #fff;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }
        .checkbox-group label {
            font-size: 14px;
            color: #4a4a4a;
            cursor: pointer;
        }
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 40px;
        }
        .product-card {
            background-color: #fff;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            transition: all 0.3s ease;
            position: relative;
        }
        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.12);
        }
        .product-image {
            position: relative;
            overflow: hidden;
            padding-top: 100%;
        }
        .product-image img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: all 0.5s ease;
        }
        .product-image:hover img:nth-child(2) {
            opacity: 1;
        }
        .product-image img:nth-child(2) {
            opacity: 0;
        }
        .product-details {
            padding: 25px;
            background: linear-gradient(to bottom, #ffffff, #f9f7f5);
        }
        .product-brand {
            color: #b0935e;
            font-weight: 600;
            margin-bottom: 8px;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 24px;
            margin-bottom: 15px;
            color: #1a1a1a;
        }
        .product-name a {
            color: #1a1a1a;
            text-decoration: none;
            transition: color 0.3s ease;
        }
        .product-name a:hover {
            color: #b0935e;
        }
        .product-price {
            font-weight: 600;
            color: #1a1a1a;
            font-size: 18px;
            display: flex;
            align-items: center;
        }
        .product-old-price {
            text-decoration: line-through;
            color: #999;
            margin-left: 10px;
            font-size: 16px;
        }
        .product-action {
            position: absolute;
            bottom: -50px;
            left: 0;
            right: 0;
            background-color: rgba(176, 147, 94, 0.9);
            display: flex;
            justify-content: center;
            padding: 15px 0;
            transition: all 0.3s ease;
        }
        .product-card:hover .product-action {
            bottom: 0;
        }
        .product-action a {
            color: #fff;
            margin: 0 15px;
            font-size: 18px;
            transition: all 0.3s ease;
        }
        .product-action a:hover {
            color: #1a1a1a;
            transform: scale(1.1);
        }
    </style>
</head>
<body>
    {{>header}}
    <div class="luxe-container">
        <h1 class="page-title">Exquisite Search Results for "{{searchQuery}}"</h1>
        
        <div class="filter-section">
            <h2 class="filter-title">Refine Your Results</h2>
           <form action="/search" method="GET">
    <div class="row">
        <div class="col-lg-3 col-md-6">
            <div class="filter-group">
                <label class="filter-label" for="brand">Brand</label>
                <select class="form-select" name="brand" id="brand">
                    <option value="">All Brands</option>
                    {{#each allBrands}}
                    <option value="{{this.name}}">{{this.name}}</option>
                    {{/each}}
                </select>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="filter-group">
                <label class="filter-label" for="date-added">Date Added</label>
                <select class="form-select" name="date_added" id="date-added">
                    <option value="">All Time</option>
                    <option value="7">Last 7 Days</option>
                    <option value="30">Last 30 Days</option>
                    <option value="90">Last 90 Days</option>
                </select>
            </div>
        </div>
        <div class="col-lg-4 col-md-6">
            <div class="filter-group">
                <label class="filter-label">Price Range</label>
                <div class="price-inputs">
                    <input type="number" name="min_price" class="form-control" placeholder="Min">
                    <input type="number" name="max_price" class="form-control" placeholder="Max">
                </div>
            </div>
        </div>
        <div class="col-lg-2 col-md-6">
            <div class="filter-group">
                <label class="filter-label">New Arrivals</label>
                <div class="checkbox-group">
                    <input type="checkbox" name="new_arrivals" id="new-arrivals">
                    <label for="new-arrivals">Show Only New Arrivals</label>
                </div>
            </div>
        </div>
    </div>
    <div class="row mt-4">
        <div class="col-lg-3 col-md-6 mx-auto">
            <button type="submit" class="btn btn-filter">Apply Filters</button>
        </div>
    </div>
</form>
        </div>

        <div class="product-grid">
            {{#each products}}
            <div class="product-card">
                <div class="product-image">
                    <a href="/productinfo?q={{this._id}}">
                        <img src="{{this.imageUrls.[0]}}" alt="{{this.name}}">
                        <img src="{{this.imageUrls.[1]}}" alt="{{this.name}}">
                    </a>
                </div>
                <div class="product-details">
                    <div class="product-brand">{{this.brand.name}}</div>
                    <h3 class="product-name">
                        <a href="/productdetail/{{this._id}}">{{this.name}}</a>
                    </h3>
                    <div class="product-price">
                        ₹{{this.price}} 
                        {{#if this.oldPrice}}
                        <span class="product-old-price">₹{{this.oldPrice}}</span>
                        {{/if}}
                    </div>
                </div>
                <div class="product-action">
                    <a href="/cart?q={{this._id}}" title="Add to Cart"><i class="fas fa-shopping-cart"></i></a>
                    <a href="/productdetail/{{this._id}}" title="Quick View"><i class="fas fa-eye"></i></a>
                    <a href="#" title="Compare"><i class="fas fa-sync-alt"></i></a>
                </div>
            </div>
            {{/each}}
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Add your JavaScript for filter functionality here
        document.getElementById('search-filter-form').addEventListener('submit', function(e) {
            e.preventDefault();
            // Implement filter logic here
            console.log('Filters applied');
        });
    </script>
</body>
</html>