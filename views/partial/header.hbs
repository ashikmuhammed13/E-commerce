<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Navbar</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <style>
        body {
            margin: 0;
            font-family: 'Montserrat', sans-serif;
            background-color: #f8f5f2;
            color: #333;
        }
        .navbar {
            background-color: #1c1c1c;
            padding: 15px 0;
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
        }
        .navbar::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(to right, transparent, #c0a080, transparent);
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .logo a {
            font-family: 'Playfair Display', serif;
            color: #c0a080;
            font-size: 32px;
            text-decoration: none;
            font-weight: 700;
            letter-spacing: 2px;
        }
        .nav-links {
            list-style: none;
            display: flex;
            margin: 0;
            padding: 0;
        }
        .nav-links li {
            margin: 0 20px;
        }
        .nav-links a {
            color: #fff;
            text-decoration: none;
            font-size: 14px;
            font-weight: 400;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: color 0.3s ease;
        }
        .nav-links a:hover {
            color: #c0a080;
        }
        .nav-icons a {
            color: #c0a080;
            font-size: 18px;
            margin-left: 25px;
            transition: color 0.3s ease;
        }
        .nav-icons a:hover {
            color: #fff;
        }
        .cart-icon {
            position: relative;
        }
        .cart-count {
            position: absolute;
            top: -8px;
            right: -8px;
            background-color: #c0a080;
            color: #1c1c1c;
            border-radius: 50%;
            padding: 2px 6px;
            font-size: 10px;
            font-weight: 600;
        }
        /* Add margin to the body content to account for the fixed navbar */
        body {
            padding-top: 70px; /* Adjust this value based on the height of your navbar */
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <div class="logo">
                <a href="/">LUXE</a>
            </div>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/sale">Sale</a></li>
                <li><a href="/shop">Shop</a></li>
                <li><a href="/wishlist">Wishlist</a></li>
                <li><a href="/showCart">Cart</a></li>
            </ul>
            <div class="nav-icons">
                <a href="#" class="search-icon"><i class="fas fa-search"></i></a>
                <a href="/profile" class="user-icon"><i class="far fa-user"></i></a>
                <a href="/showCart" class="cart-icon">
                    <i class="fas fa-shopping-cart"></i>
                    <span class="cart-count"></span>
                </a>
            </div>
        </div>
    </nav>
</body>
</html>
