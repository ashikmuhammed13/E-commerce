<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luxury Shopping Cart - LUXE</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
body {
    font-family: 'Montserrat', sans-serif;
    background-color: #f8f5f2;
    color: #333;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    margin: 0;
    padding-top: 70px;
}

/* Navbar styles */
.navbar {
    background-color: #1c1c1c;
    padding: 15px 0;
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 1000;
}

.navbar::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, #c0a080, transparent);
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

.navbar .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo a {
    font-family: 'Playfair Display', serif;
    color: #c0a080;
    font-size: 32px;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 2px;
}

.nav-links {
    list-style: none;
    display: flex;
    margin: 0;
    padding: 0;
}

.nav-links li {
    margin: 0 20px;
}

.nav-links a {
    color: #fff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: color 0.3s ease;
}

.nav-links a:hover {
    color: #c0a080;
}

.nav-icons a {
    color: #c0a080;
    font-size: 18px;
    margin-left: 25px;
    transition: color 0.3s ease;
}

.nav-icons a:hover {
    color: #fff;
}

.cart-icon {
    position: relative;
}

.cart-count {
    position: absolute;
    top: -8px;
    right: -8px;
    background-color: #c0a080;
    color: #1c1c1c;
    border-radius: 50%;
    padding: 2px 6px;
    font-size: 10px;
    font-weight: 600;
}

.menu-toggle {
    display: none;
    background: none;
    border: none;
    color: #c0a080;
    font-size: 24px;
    cursor: pointer;
}

/* Breadcrumb styles */
.breadcrumb-area {
    background-color: #1c1c1c;
    padding: 60px 0;
    position: relative;
}

.breadcrumb-text h1 {
    color: #c0a080;
    font-family: 'Playfair Display', serif;
    font-size: 48px;
    margin-bottom: 10px;
}

.breadcrumb-menu {
    padding: 0;
    margin: 0;
    list-style: none;
}

.breadcrumb-menu li {
    display: inline-block;
    color: #fff;
    font-size: 14px;
}

.breadcrumb-menu li:not(:last-child)::after {
    content: '/';
    margin: 0 5px;
    color: #c0a080;
}

.breadcrumb-menu li a {
    color: #c0a080;
    text-decoration: none;
}

/* Cart area styles */
.cart-area {
    padding: 80px 0;
}

.table {
    border-collapse: separate;
    border-spacing: 0 15px;
}

.table thead th {
    border-bottom: 2px solid #c0a080;
    color: #1c1c1c;
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-weight: 700;
    padding: 15px;
    text-transform: uppercase;
}

.table tbody td {
    background-color: #fff;
    border: none;
    padding: 20px 15px;
    vertical-align: middle;
}

.table tbody tr {
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
}

.table tbody tr:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.12);
}

.product-thumbnail img {
    max-width: 80px;
    border-radius: 5px;
}

.product-name a {
    color: #1c1c1c;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.3s ease;
}

.product-name a:hover {
    color: #c0a080;
}

.amount {
    color: #c0a080;
    font-weight: 600;
}

.cart-quantity-wrapper {
    border: 1px solid #c0a080 !important;
}

.quantity-btn {
    color: #c0a080 !important;
}

.quantity-input {
    color: #1c1c1c;
    font-weight: 600;
}

.product-remove a {
    color: #1c1c1c;
    font-size: 18px;
    transition: color 0.3s ease;
}

.product-remove a:hover {
    color: #c0a080;
}

/* Coupon and cart total styles */
.coupon-all {
    margin-top: 50px;
}

.input-text {
    border: 1px solid #c0a080;
    padding: 10px 15px;
    margin-right: 10px;
}

.theme-btn-2 {
    background-color: #c0a080;
    border: none;
    color: #1c1c1c;
    padding: 10px 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
}

.theme-btn-2:hover {
    background-color: #1c1c1c;
    color: #c0a080;
}

.cart-page-total {
    background-color: #fff;
    padding: 30px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
}

.cart-page-total h2 {
    font-family: 'Playfair Display', serif;
    color: #1c1c1c;
    font-size: 24px;
    margin-bottom: 20px;
}

.cart-page-total ul {
    list-style: none;
    padding: 0;
}

.cart-page-total ul li {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
    font-weight: 600;
}

.theme-btn {
    background-color: #c0a080;
    border: none;
    color: #1c1c1c;
    padding: 15px 30px;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    display: inline-block;
    text-decoration: none;
    margin-top: 20px;
}

.theme-btn:hover {
    background-color: #1c1c1c;
    color: #c0a080;
}

.cart-wrapper {
    display: flex;
    justify-content: space-between;
    margin-top: 50px;
}

.cart-details {
    width: 65%;
}

.cart-totals {
    width: 30%;
}

/* Empty cart styles */
.empty-cart-container {
    flex-grow: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 50px 20px;
}

.empty-cart-content {
    text-align: center;
    background-color: #fff;
    padding: 50px;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    max-width: 600px;
    width: 100%;
}

.empty-cart-icon {
    font-size: 80px;
    color: #c0a080;
    margin-bottom: 30px;
}

.empty-cart-content h1 {
    font-family: 'Playfair Display', serif;
    color: #1c1c1c;
    font-size: 36px;
    margin-bottom: 20px;
}

.empty-cart-content p {
    color: #666;
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 30px;
}

/* Responsive styles */
@media (max-width: 768px) {
    .menu-toggle {
        display: block;
    }

    .nav-links {
        display: none;
        flex-direction: column;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background-color: #1c1c1c;
        padding: 20px;
    }

    .nav-links.show {
        display: flex;
    }

    .nav-links li {
        margin: 10px 0;
    }

    .nav-icons {
        display: none;
    }

    .cart-wrapper {
        flex-direction: column;
    }

    .cart-details,
    .cart-totals {
        width: 100%;
    }

    .cart-totals {
        margin-top: 30px;
    }

    .table thead {
        display: none;
    }

    .table tbody tr {
        display: block;
        margin-bottom: 20px;
    }

    .table tbody td {
        display: block;
        text-align: right;
        padding: 10px;
    }

    .table tbody td::before {
        content: attr(data-label);
        float: left;
        font-weight: bold;
        text-transform: uppercase;
    }

    .product-thumbnail img {
        max-width: 100%;
    }

    .breadcrumb-text h1 {
        font-size: 36px;
    }

    .empty-cart-content {
        padding: 30px;
    }

    .empty-cart-content h1 {
        font-size: 28px;
    }

    .empty-cart-content p {
        font-size: 16px;
    }
}

@media (max-width: 480px) {
    .logo a {
        font-size: 24px;
    }

    .breadcrumb-text h1 {
        font-size: 28px;
    }

    .theme-btn,
    .theme-btn-2 {
        padding: 10px 15px;
        font-size: 14px;
    }
}
</style>
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <div class="logo">
                <a href="/">LUXE</a>
            </div>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/sale">Sale</a></li>
                <li><a href="/shop">Shop</a></li>
                <li><a href="/wishlist">Wishlist</a></li>
                <li><a href="/showCart">Cart</a></li>
            </ul>
            <div class="nav-icons">
                <a href="#" class="search-icon"><i class="fas fa-search"></i></a>
                <a href="/profile" class="user-icon"><i class="far fa-user"></i></a>
                <a href="/showCart" class="cart-icon">
                    <i class="fas fa-shopping-cart"></i>
                    <span class="cart-count"></span>
                </a>
            </div>
        </div>
    </nav>
    <main>
        <div class="breadcrumb-area">
            <div class="container">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="breadcrumb-text text-center">
                            <h1>Shopping Cart</h1>
                            <ul class="breadcrumb-menu">
                                <li><a href="/">Home</a></li>
                                <li><span>Cart</span></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        

        {{#if products.length}}
        <section class="cart-area pt-100 pb-100">
            <div class="container">
                <div class="cart-wrapper">
                    <div class="cart-details">
                        <form id="cart-form" onsubmit="return false;">
                            <div class="table-content table-responsive">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th class="product-thumbnail">Images</th>
                                            <th class="cart-product-name">Product</th>
                                            <th class="product-price">Unit Price</th>
                                            <th class="product-quantity">Quantity</th>
                                            <th class="product-subtotal">Total</th>
                                            <th class="product-remove">Remove</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{#each products}}
                                        <tr>
                                            <td class="product-thumbnail">
                                                <a href="#">
                                                    <img src="{{this.productId.imageUrls.[0]}}" alt="">
                                                </a>
                                            </td>
                                            <td class="product-name">
                                                <a href="#">{{this.productId.name}}</a>
                                            </td>
                                            <td class="product-price">
                                                <span class="amount">₹{{this.productId.price}}</span>
                                            </td>
                                            <td>
                                                <div class="cart-quantity-wrapper" style="display: flex; align-items: center; justify-content: center; border: 1px solid #e0e0e0; border-radius: 25px; overflow: hidden; width: 150px;">
                                                    <button class="quantity-btn minus" data-product-id="{{this.productId._id}}" style="background: none; border: none; padding: 10px; cursor: pointer; font-size: 18px; color: #c0a080;">-</button>
                                                    <input type="number" value="{{this.quantity}}" min="1" data-product-id="{{this.productId._id}}" class="quantity-input" style="width: 40px; text-align: center; border: none; font-size: 16px;" readonly>
                                                    <button class="quantity-btn plus" data-product-id="{{this.productId._id}}" style="background: none; border: none; padding: 10px; cursor: pointer; font-size: 18px; color: #c0a080;">+</button>
                                                </div>
                                            </td>
                                            <td class="product-subtotal">
                                                <span class="amount subtotal-amount">₹{{this.totalPrice}}</span>
                                            </td>
                                            <td class="product-remove">
                                                <a href="/removeCart/{{this.productId._id}}"><i class="fa fa-times"></i></a>
                                            </td>
                                        </tr>
                                        {{/each}}
                                    </tbody>
                                </table>
                            </div>
                            <div class="coupon-all">
                                <div class="coupon">
                                    <input id="coupon_code" class="input-text" name="coupon_code" value="" placeholder="Coupon code" type="text">
                                    <button class="btn theme-btn-2" name="apply_coupon" type="submit">Apply coupon</button>
                                </div>
                                <div class="coupon2">
                                    <input class="btn theme-btn" name="update_cart" value="Update cart" type="submit">
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="cart-totals">
                        <div class="cart-page-total">
                            <h2>Cart totals</h2>
                            <ul class="mb-20">
                                <li>Subtotal <span>₹{{totalValue}}</span></li>
                                <li>Total <span class="cart-total-price">₹{{this.cartTotal}}</span></li>
                            </ul>
                            <a class="btn theme-btn" href="/checkout">Proceed to checkout</a>
                        </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </section>
        {{else}}
        
    <div class="empty-cart-container">
        <div class="empty-cart-content">
            <div class="empty-cart-icon">
                <i class="fas fa-shopping-cart"></i>
            </div>
            <h1>Your Cart is Empty</h1>
            <p>Explore our collection and add some luxury to your life. Indulge in premium products that reflect your refined taste.</p>
            <a href="/shop" class="btn">Start Shopping</a>
        </div>
    </div>
    {{/if}}
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const quantityWrappers = document.querySelectorAll('.cart-quantity-wrapper');

            quantityWrappers.forEach(wrapper => {
                const minusBtn = wrapper.querySelector('.minus');
                const plusBtn = wrapper.querySelector('.plus');
                const input = wrapper.querySelector('.quantity-input');
                const productId = input.dataset.productId;

                minusBtn.addEventListener('click', () => updateQuantity(productId, -1));
                plusBtn.addEventListener('click', () => updateQuantity(productId, 1));
            });

            function updateQuantity(productId, change) {
                const input = document.querySelector(`.quantity-input[data-product-id="${productId}"]`);
                let newQuantity = parseInt(input.value) + change;
                if (newQuantity < 1) newQuantity = 1;

                fetch('/updateCartQuantity', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ productId, quantity: newQuantity }),
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        input.value = data.newQuantity;
                        const subtotalElement = input.closest('tr').querySelector('.subtotal-amount');
                        subtotalElement.textContent = `₹${data.newTotalPrice.toFixed(2)}`;
                        
                        // Update the total cart value
                        const totalPriceElement = document.querySelector('.cart-total-price');
                        totalPriceElement.textContent = `₹${data.totalCartValue.toFixed(2)}`;
                    } else {
                        console.error('Failed to update quantity:', data.message);
                    }
                })
                .catch(error => {
                    console.error('Error updating quantity:', error);
                });
            }
        });
    </script>
</body>
</html>