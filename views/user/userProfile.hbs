<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luxury User Profile</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://kit.fontawesome.com/your-fontawesome-kit.js" crossorigin="anonymous"></script>
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f8f5f2;
            color: #333;
        }
        .navbar {
            background-color: #1c1c1c;
            padding: 15px 0;
        }
        .navbar-brand {
            font-family: 'Playfair Display', serif;
            color: #c0a080 !important;
            font-size: 32px;
            font-weight: 700;
            letter-spacing: 2px;
        }
        .nav-link {
            color: #fff !important;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: color 0.3s ease;
        }
        .nav-link:hover {
            color: #c0a080 !important;
        }
        .btn-logout {
            background-color: #c0a080;
            color: #1c1c1c;
            border: none;
            padding: 10px 20px;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s ease;
        }
        .btn-logout:hover {
            background-color: #1c1c1c;
            color: #c0a080;
        }
        .profile-header {
            background-color: #1c1c1c;
            color: #c0a080;
            padding: 40px 0;
        }
        .profile-header h1 {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
        }
        .card {
            border: none;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
        }
        .card-header {
            background-color: #1c1c1c;
            color: #c0a080;
            font-family: 'Playfair Display', serif;
            font-weight: 700;
        }
        .table {
            color: #333;
        }
        .table thead th {
            border-bottom: 2px solid #c0a080;
        }
        .btn-primary {
            background-color: #c0a080;
            border-color: #c0a080;
            color: #1c1c1c;
        }
        .btn-primary:hover {
            background-color: #1c1c1c;
            border-color: #c0a080;
            color: #c0a080;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/">LUXE</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/shop">Shop</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/profile">Profile</a>
                    </li>
                    <a href="/logout">
                    <li class="nav-item">
                        <button class="btn btn-logout">Logout</button>
                    </li>
                    </a>
                </ul>
            </div>
        </div>
    </nav>

    <header class="profile-header">
        <div class="container">
            <h1>Welcome, {{user.username}}</h1>
        </div>
    </header>

<main class="container my-5">
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    User Information
                </div>
                <div class="card-body">
                    <p><strong>Email:</strong> {{user.email}}</p>
                    <p><strong>Phone:</strong> {{user.phone}}</p>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#editProfileModal">Edit Profile</button>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    Order History
                </div>
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Products</th>
                                
                                <th>Date</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Quantity</th> <!-- New column for quantity -->
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each orders}}
                            <tr>
                                <td>
                                    {{#each this.items}}
                                    <div>
                                        <img src="{{this.product.imageUrls.[0]}}" alt="{{this.product.name}}" style="width: 50px; height: 50px;">
                                        <p>{{this.product.name}}</p>
                                    </div>
                                    {{/each}}
                                </td>
                                
                                {{!-- <td>{{formatDate this.datePlaced}}</td> --}}
                                <td>${{this.totalAmount}}</td>
                                <td>{{this.status}}</td>
                                <td>
                                    {{#each this.items}}
                                    <p>{{this.quantity}}</p>
                                    {{/each}}
                                </td> <!-- Display quantity -->
                                <td>
                                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#orderDetailsModal{{this._id}}">Details</button>
                                    {{!-- {{#if (eq this.status "delivered")}}
                                    <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#returnModal{{this._id}}">Return</button>
                                    {{/if}} --}}
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>




    <!-- Edit Profile Modal -->
    <div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editProfileModalLabel">Edit Profile</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="editProfileForm">
                        <div class="mb-3">
                            <label for="username" class="form-label">Username</label>
                            <input type="text" class="form-control" id="username" value="{{user.username}}" required>
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" value="{{user.email}}" required>
                        </div>
                        <div class="mb-3">
                            <label for="phone" class="form-label">Phone</label>
                            <input type="tel" class="form-control" id="phone" value="{{user.phone}}" required>
                        </div>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Order Details Modal -->
    {{#each orders}}
    <div class="modal fade" id="orderDetailsModal{{this._id}}" tabindex="-1" aria-labelledby="orderDetailsModalLabel{{this._id}}" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="orderDetailsModalLabel{{this._id}}">Order Details: {{this.orderID}}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    {{!-- <p><strong>Order Date:</strong> {{formatDate this.datePlaced}}</p> --}}
                    <p><strong>Total Amount:</strong> ${{this.totalAmount}}</p>
                    <p><strong>Status:</strong> {{this.status}}</p>
                    <p><strong>Payment Method:</strong> {{this.paymentMethod}}</p>
                    {{!-- <p><strong>Expected Delivery:</strong> {{formatDate this.deliveryExpectedDate}}</p> --}}
                    <h6>Items:</h6>
                    <ul>
                        {{#each this.items}}
                        <li>{{this.product.name}} - Quantity: {{this.quantity}} - Price: ${{this.price}}</li>
                        {{/each}}
                    </ul>
                </div>
            </div>
        </div>
    </div>
    {{/each}}

    <!-- Return Modal -->
    {{#each orders}}
    {{!-- {{#if (eq this.status "delivered")}} --}}
    <div class="modal fade" id="returnModal{{this._id}}" tabindex="-1" aria-labelledby="returnModalLabel{{this._id}}" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="returnModalLabel{{this._id}}">Return Order: {{this.orderID}}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to return this order?</p>
                    <form id="returnForm{{this._id}}">
                        <div class="mb-3">
                            <label for="returnReason{{this._id}}" class="form-label">Reason for Return</label>
                            <textarea class="form-control" id="returnReason{{this._id}}" rows="3" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-warning">Submit Return Request</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    {{!-- {{/if}} --}}
    {{/each}}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const editProfileForm = document.getElementById('editProfileForm');
            editProfileForm.addEventListener('submit', function(e) {
                e.preventDefault();
                // Here you would typically send an AJAX request to update the user profile
                console.log('Update profile:', {
                    username: document.getElementById('username').value,
                    email: document.getElementById('email').value,
                    phone: document.getElementById('phone').value
                });
                // After successful update, you might want to show a success message or close the modal
                alert('Profile updated successfully!');
                document.getElementById('editProfileModal').classList.remove('show');
                document.body.classList.remove('modal-open');
                document.querySelector('.modal-backdrop').remove();
            });

            // Add event listeners for return forms
            document.querySelectorAll('form[id^="returnForm"]').forEach(form => {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const orderId = this.id.replace('returnForm', '');
                    const reason = document.getElementById(`returnReason${orderId}`).value;
                    console.log('Return request for order:', orderId, 'Reason:', reason);
                    // Here you would typically send an AJAX request to process the return
                    alert('Return request submitted successfully!');
                    document.getElementById(`returnModal${orderId}`).classList.remove('show');
                    document.body.classList.remove('modal-open');
                    document.querySelector('.modal-backdrop').remove();
                });
            });
        });
    </script>
</body>
</html>