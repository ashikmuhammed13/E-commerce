<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luxury Product View</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <script src="https://kit.fontawesome.com/your-fontawesome-kit.js" crossorigin="anonymous"></script>
    <style>
        body {
            margin: 0;
            font-family: 'Montserrat', sans-serif;
            background-color: #f8f5f2;
            color: #1c1c1c;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }
        .product-area {
            padding: 80px 0;
        }
        .product-grid {
            display: flex;
            flex-wrap: wrap;
            margin: -15px;
        }
        .product-image-area, .product-info-area {
            flex: 1;
            padding: 15px;
            min-width: 300px;
        }
        .product-image {
            width: 100%;
            height: auto;
            object-fit: cover;
            border: 1px solid #e0e0e0;
        }
        .product-thumbnails {
            display: flex;
            margin-top: 20px;
        }
        .thumbnail {
            width: 80px;
            height: 80px;
            object-fit: cover;
            margin-right: 10px;
            border: 1px solid #e0e0e0;
            cursor: pointer;
            transition: border-color 0.3s ease;
        }
        .thumbnail:hover {
            border-color: #c0a080;
        }
        .product-title {
            font-family: 'Playfair Display', serif;
            font-size: 32px;
            margin-bottom: 20px;
            color: #1c1c1c;
        }
        .product-price {
            font-size: 24px;
            color: #c0a080;
            margin-bottom: 20px;
        }
        .old-price {
            text-decoration: line-through;
            color: #888;
            margin-left: 10px;
        }
        .product-description {
            margin-bottom: 30px;
            line-height: 1.6;
        }
        .product-meta {
            margin-bottom: 30px;
        }
        .product-meta-item {
            margin-bottom: 10px;
        }
        .product-meta-label {
            font-weight: 600;
            margin-right: 10px;
        }
        .add-to-cart-btn {
            background-color: #c0a080;
            color: #fff;
            border: none;
            padding: 12px 24px;
            font-size: 16px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }
        .add-to-cart-btn:hover {
            background-color: #a88b6a;
        }
        .quantity-input {
            width: 60px;
            padding: 10px;
            margin-right: 10px;
            border: 1px solid #e0e0e0;
        }
        .product-actions {
            display: flex;
            align-items: center;
            margin-top: 20px;
        }
        .action-btn {
            background: none;
            border: none;
            color: #c0a080;
            font-size: 18px;
            margin-right: 15px;
            cursor: pointer;
        }
        .tabs {
            margin-top: 50px;
        }
        .tab-buttons {
            display: flex;
            border-bottom: 1px solid #e0e0e0;
        }
        .tab-button {
            padding: 10px 20px;
            background: none;
            border: none;
            font-family: 'Montserrat', sans-serif;
            font-size: 16px;
            cursor: pointer;
            transition: color 0.3s ease;
        }
        .tab-button.active {
            color: #c0a080;
            border-bottom: 2px solid #c0a080;
        }
        .tab-content {
            padding: 30px 0;
        }
        .review {
            margin-bottom: 30px;
        }
        .review-author {
            font-weight: 600;
            margin-bottom: 5px;
        }
        .review-date {
            color: #888;
            font-size: 14px;
            margin-bottom: 10px;
        }
        .related-products {
            margin-top: 80px;
        }
        .related-products-title {
            font-family: 'Playfair Display', serif;
            font-size: 24px;
            margin-bottom: 30px;
            text-align: center;
        }
        .related-products-grid {
            display: flex;
            flex-wrap: wrap;
            margin: -15px;
        }
        .related-product-item {
            flex: 0 0 calc(25% - 30px);
            margin: 15px;
            text-align: center;
        }
        .related-product-image {
            width: 100%;
            height: auto;
            object-fit: cover;
            margin-bottom: 15px;
        }
        .related-product-title {
            font-size: 16px;
            margin-bottom: 10px;
        }
        .related-product-price {
            color: #c0a080;
            font-weight: 600;
        }
    </style>
</head>
<body> 
    {{>header}}
    <main class="product-area">
        <div class="container">
            <div class="product-grid">
                <div class="product-image-area">
                    <div class="product-large-img">
                        <img src="{{product.imageUrls.[0]}}" alt="{{product.name}}" class="product-image" id="main-product-image">
                    </div>
                    <div class="product-thumbnails">
                        {{#each product.imageUrls}}
                        <img src="{{this}}" alt="Thumbnail {{@index}}" class="thumbnail" onclick="changeMainImage(this.src)">
                        {{/each}}
                    </div>
                </div>
                <div class="product-info-area">
                    <div class="details-cat mb-20">
                        <a href="#">{{product.category1}}</a>, <a href="#">{{product.category2}}</a>
                    </div>
                    <h1 class="product-title">{{product.name}}</h1>
                    <div class="product-price">
                        <span>₹{{product.price}}</span>
                        <span class="old-price">₹{{product.oldprice}}</span>
                    </div>
                    <p class="product-description">{{product.description}}</p>
                    <div class="product-meta">
                        <div class="product-meta-item">
                            <span class="product-meta-label">Brand:</span>
                            <span>{{product.brand.name}}</span>
                        </div>
                        <div class="product-meta-item">
                            <span class="product-meta-label">Product Code:</span>
                            <span>d12</span>
                        </div>
                        <div class="product-meta-item">
                            <span class="product-meta-label">Reward Points:</span>
                            <span>100</span>
                        </div>
                        <div class="product-meta-item">
                            <span class="product-meta-label">Availability:</span>
                            <span class="in-stock">In Stock</span>
                        </div>
                    </div>
                    <form action="/cart" method="GET">
                    <input type="hidden" name="q" value="{{product._id}}">
                    <div class="product-actions">
                        <div class="plus-minus">
                            <input type="number" name="quantity" value="1" min="1" class="quantity-input">
                        </div>
                        <button type="submit" class="add-to-cart-btn">+ Add to Cart</button>
                        <button type="button" class="action-btn" title="Add to Wishlist"><i class="fas fa-heart"></i></button>
                        <button type="button" class="action-btn" title="Compare"><i class="fas fa-exchange-alt"></i></button>
                    </div>
                </form>
                </div>
            </div>
            
            <div class="tabs">
                <div class="tab-buttons">
                    <button class="tab-button active" onclick="openTab(event, 'description')">Description</button>
                    <button class="tab-button" onclick="openTab(event, 'reviews')">Reviews</button>
                </div>
                <div id="description" class="tab-content">
                    <p>{{product.fullDescription}}</p>
                </div>
                <div id="reviews" class="tab-content" style="display:none;">
                    {{#each product.reviews}}
                    <div class="review">
                        <div class="review-author">{{this.author}}</div>
                        <div class="review-date">{{this.date}}</div>
                        <p>{{this.content}}</p>
                    </div>
                    {{/each}}
                </div>
            </div>

            <div class="related-products">
                <h2 class="related-products-title">Related Products</h2>
                <div class="related-products-grid">
                    {{#each firstPartProducts}}
                    <div class="related-product-item">
                        <a href="/productinfo?q={{this._id}}">
                            <img src="{{this.imageUrls.[0]}}" alt="{{this.name}}" class="related-product-image">
                            <h3 class="related-product-title">{{this.name}}</h3>
                            <div class="related-product-price">₹{{this.price}}</div>
                        </a>
                    </div>
                    {{/each}}
                </div>
            </div>
        </div>
    </main>

    <script>
        function changeMainImage(src) {
            document.getElementById('main-product-image').src = src;
        }

        function openTab(evt, tabName) {
            var i, tabcontent, tablinks;
            tabcontent = document.getElementsByClassName("tab-content");
            for (i = 0; i < tabcontent.length; i++) {
                tabcontent[i].style.display = "none";
            }
            tablinks = document.getElementsByClassName("tab-button");
            for (i = 0; i < tablinks.length; i++) {
                tablinks[i].className = tablinks[i].className.replace(" active", "");
            }
            document.getElementById(tabName).style.display = "block";
            evt.currentTarget.className += " active";
        }
    </script>
</body>
</html>