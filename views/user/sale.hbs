<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luxury Bag Sale</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Playfair Display', serif;
            background-color: #f8f9fa;
        }
        .banner {
            background-image: url('https://png.pngtree.com/background/20210711/original/pngtree-e-commerce-luxury-handbags-promotion-yellow-banner-picture-image_1115463.jpg');
            background-size: cover;
            background-position: center;
            height: 400px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            text-align: center;
        }
        .banner h1 {
            font-size: 4rem;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        }
        .product-card {
            background-color: white;
            border: none;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            transition: transform 0.3s;
        }
        .product-card:hover {
            transform: translateY(-5px);
        }
        .feature-icon {
            font-size: 2rem;
            color: #d4af37;
        }
        .btn-gold {
            background-color: #d4af37;
            border-color: #d4af37;
            color: white;
        }
        .btn-gold:hover {
            background-color: #c49b30;
            border-color: #c49b30;
            color: white;
        }
    </style>
</head>
<body>
    {{>allheader}}
    <div class="banner mb-5">
        <div>
            <h1>Luxury Bag Sale</h1>
            <p class="lead">Exclusive offers on premium bags</p>
        </div>
    </div>

    <div class="container">
        <h2 class="text-center mb-5">Featured Products</h2>
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card product-card">
                    <img src="https://img.freepik.com/premium-photo/fashion-luxury-women-handback-colorful-print-summer-bags-banner-accessories_162585-5508.jpg" class="card-img-top" alt="Elegant Tote">
                    <div class="card-body">
                        <h5 class="card-title">Elegant Tote</h5>
                        <p class="card-text">Spacious and stylish tote bag for everyday elegance.</p>
                        <p class="card-text"><strong>Price: $299</strong> <span class="text-muted text-decoration-line-through">$399</span></p>
                        <button class="btn btn-gold">Add to Cart</button>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card product-card">
                    <img src="https://img.freepik.com/premium-photo/fashion-luxury-women-handback-colorful-print-summer-bags-banner-accessories_162585-5508.jpg" class="card-img-top" alt="Designer Clutch">
                    <div class="card-body">
                        <h5 class="card-title">Designer Clutch</h5>
                        <p class="card-text">Sleek and sophisticated clutch for special occasions.</p>
                        <p class="card-text"><strong>Price: $199</strong> <span class="text-muted text-decoration-line-through">$279</span></p>
                        <button class="btn btn-gold">Add to Cart</button>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card product-card">
                    <img src="https://img.freepik.com/premium-photo/fashion-luxury-women-handback-colorful-print-summer-bags-banner-accessories_162585-5508.jpg" class="card-img-top" alt="Premium Backpack">
                    <div class="card-body">
                        <h5 class="card-title">Premium Backpack</h5>
                        <p class="card-text">Luxurious and practical backpack for the modern traveler.</p>
                        <p class="card-text"><strong>Price: $349</strong> <span class="text-muted text-decoration-line-through">$459</span></p>
                        <button class="btn btn-gold">Add to Cart</button>
                    </div>
                </div>
            </div>
        </div>

        <h2 class="text-center my-5">Why Choose Our Bags?</h2>
        <div class="row text-center">
            <div class="col-md-4 mb-4">
                <div class="feature-icon mb-3">&#9989;</div>
                <h4>Premium Quality</h4>
                <p>Crafted with the finest materials for lasting elegance.</p>
            </div>
            <div class="col-md-4 mb-4">
                <div class="feature-icon mb-3">&#128230;</div>
                <h4>Free Shipping</h4>
                <p>Enjoy complimentary shipping on all orders over $500.</p>
            </div>
            <div class="col-md-4 mb-4">
                <div class="feature-icon mb-3">&#128142;</div>
                <h4>Exclusive Designs</h4>
                <p>Unique styles you won't find anywhere else.</p>
            </div>
        </div>
    </div>
    {{>footer}}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Add a simple animation to the banner text
        document.addEventListener('DOMContentLoaded', function() {
            const bannerText = document.querySelector('.banner h1');
            bannerText.style.opacity = '0';
            bannerText.style.transform = 'translateY(20px)';
            setTimeout(() => {
                bannerText.style.transition = 'opacity 1s, transform 1s';
                bannerText.style.opacity = '1';
                bannerText.style.transform = 'translateY(0)';
            }, 300);
        });

        // Add to cart functionality
        const addToCartButtons = document.querySelectorAll('.btn-gold');
        addToCartButtons.forEach(button => {
            button.addEventListener('click', function() {
                alert('Item added to cart!');
            });
        });
    </script>
</body>
</html>