<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luxury Wishlist - LUXE</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>

/* General styles */
body {
    font-family: 'Montserrat', sans-serif;
    background-color: #f8f5f2;
    color: #333;
}

/* Navigation styles */
.navbar {
    background-color: #1c1c1c;
    padding: 15px 0;
}

.navbar-brand {
    font-family: 'Playfair Display', serif;
    color: #c0a080 !important;
    font-size: 32px;
    font-weight: 700;
    letter-spacing: 2px;
}

.nav-link {
    color: #fff !important;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: color 0.3s ease;
}

.nav-link:hover {
    color: #c0a080 !important;
}

/* Breadcrumb styles */
.breadcrumb-area {
    background-image: url('img/bg/page-title.png');
    background-size: cover;
    background-position: center;
    padding: 100px 0;
    position: relative;
}

.breadcrumb-area::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(28, 28, 28, 0.7);
}

.breadcrumb-text {
    position: relative;
    z-index: 1;
}

.breadcrumb-text h1 {
    color: #c0a080;
    font-family: 'Playfair Display', serif;
    font-size: 48px;
    margin-bottom: 10px;
}

.breadcrumb-menu {
    padding: 0;
    margin: 0;
    list-style: none;
}

.breadcrumb-menu li {
    display: inline-block;
    color: #fff;
    font-size: 14px;
}

.breadcrumb-menu li:not(:last-child)::after {
    content: '/';
    margin: 0 5px;
    color: #c0a080;
}

.breadcrumb-menu li a {
    color: #c0a080;
    text-decoration: none;
}

/* Cart and Wishlist area styles */
.cart-area, .wishlist-area {
    padding: 80px 0;
}

.table {
    border-collapse: separate;
    border-spacing: 0 15px;
}

.table thead th {
    border-bottom: 2px solid #c0a080;
    color: #1c1c1c;
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-weight: 700;
    padding: 15px;
    text-transform: uppercase;
}

.table tbody td {
    background-color: #fff;
    border: none;
    padding: 20px 15px;
    vertical-align: middle;
}

.table tbody tr {
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
}

.table tbody tr:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.12);
}

.product-thumbnail img {
    max-width: 80px;
    border-radius: 5px;
}

.product-name a {
    color: #1c1c1c;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.3s ease;
}

.product-name a:hover {
    color: #c0a080;
}

.amount {
    color: #c0a080;
    font-weight: 600;
}

.btn-add-to-cart, .btn-luxury {
    background-color: #c0a080;
    border: none;
    color: #1c1c1c;
    padding: 10px 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
}

.btn-add-to-cart:hover, .btn-luxury:hover {
    background-color: #1c1c1c;
    color: #c0a080;
}

.product-remove a {
    color: #1c1c1c;
    font-size: 18px;
    transition: color 0.3s ease;
}

.product-remove a:hover {
    color: #c0a080;
}

/* Empty wishlist and login required styles */
.empty-wishlist-container {
    border: 1px solid #c0a080;
    background-color: #fff;
    padding: 50px;
    border-radius: 10px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

.empty-wishlist-icon {
    font-size: 64px;
    color: #c0a080;
    margin-bottom: 20px;
}

.empty-wishlist-title {
    font-family: 'Playfair Display', serif;
    color: #1c1c1c;
    font-size: 36px;
    margin-bottom: 15px;
}

.empty-wishlist-message {
    color: #666;
    font-size: 18px;
    margin-bottom: 30px;
}

.btn-luxury {
    font-family: 'Montserrat', sans-serif;
    font-weight: 600;
    padding: 12px 30px;
    font-size: 16px;
}

.text-luxury {
    color: #c0a080;
    text-decoration: none;
    transition: color 0.3s ease;
}

.text-luxury:hover {
    color: #1c1c1c;
}

/* Footer styles */
footer {
    background-color: #1c1c1c;
    color: #fff;
    padding: 50px 0;
}

.footer-widget h3 {
    color: #c0a080;
    font-family: 'Playfair Display', serif;
    font-size: 24px;
    margin-bottom: 20px;
}

.footer-widget ul {
    list-style: none;
    padding: 0;
}

.footer-widget ul li a {
    color: #fff;
    text-decoration: none;
    transition: color 0.3s ease;
}

.footer-widget ul li a:hover {
    color: #c0a080;
}

/* Responsive adjustments */
@media (max-width: 768px) {
    .navbar-brand {
        font-size: 24px;
    }

    .breadcrumb-text h1 {
        font-size: 36px;
    }

    .empty-wishlist-title {
        font-size: 28px;
    }

    .empty-wishlist-message {
        font-size: 16px;
    }

    .btn-luxury {
        padding: 10px 20px;
        font-size: 14px;
    }
}
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/">LUXE</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/shop">Shop</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/wishlist">Wishlist</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/cart">Cart</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

  <main>
    <section class="breadcrumb-area" data-background="img/bg/page-title.png">
        <div class="container">
            <div class="row">
                <div class="col-xl-12">
                    <div class="breadcrumb-text text-center">
                        <h1>Wishlist</h1>
                        <ul class="breadcrumb-menu">
                            <li><a href="/">Home</a></li>
                            <li><span>Wishlist</span></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {{#if wishlist.products.length}}
        <section class="cart-area pt-100 pb-100">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <div class="table-content table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th class="product-thumbnail">Image</th>
                                        <th class="cart-product-name">Product</th>
                                        <th class="product-price">Price</th>
                                        <th class="product-quantity">Add to Cart</th>
                                        <th class="product-subtotal">Subtotal</th>
                                        <th class="product-remove">Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each wishlist.products}}
                                        <tr>
                                            <td class="product-thumbnail">
                                                <a href="/productinfo?q={{this._id}}">
                                                    <img src="{{this.imageUrls.[0]}}" alt="{{this.name}}" class="related-product-image">
                                                </a>
                                            </td>
                                            <td class="product-name">
                                                <a href="/productinfo?q={{this._id}}">{{this.name}}</a>
                                            </td>
                                            <td class="product-price">
                                                <span class="amount">₹{{this.price}}</span>
                                            </td>
                                            <td class="product-quantity">
                                                <a href="/cart?q={{this._id}}" class="btn btn-add-to-cart">Add to Cart</a>
                                            </td>
                                            {{!-- <td class="product-quantity"></td>
                                                <button class="btn btn-add-to-cart" type="button" data-product-id="{{this._id}}">Add to Cart</button>
                                            </td> --}}
                                            <td class="product-subtotal">
                                                <span class="amount">₹{{this.price}}</span>
                                            </td>
                                            <td class="product-remove">
                                                <a href="/removeWishlist?q={{this._id}}"><i class="fa fa-times"></i></a>
                                            </td>
                                        </tr>
                                    {{/each}}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    {{else}}
        {{#if user}} <!-- Assuming 'user' is passed to the template -->
            <section class="wishlist-area py-5">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-md-8 text-center">
                            <div class="empty-wishlist-container p-5 bg-white shadow-lg rounded">
                                <i class="fas fa-heart empty-wishlist-icon mb-4"></i>
                                <h2 class="empty-wishlist-title mb-3">Your Wishlist is Empty</h2>
                                <p class="empty-wishlist-message mb-4">Discover our exquisite collection and add your favorite pieces to your wishlist.</p>
                                <a href="/shop" class="btn btn-luxury btn-lg">Explore Our Collection</a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        {{else}}
            <section class="wishlist-area py-5">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-md-8 text-center">
                            <div class="empty-wishlist-container p-5 bg-white shadow-lg rounded">
                                <i class="fas fa-user-lock empty-wishlist-icon mb-4"></i>
                                <h2 class="empty-wishlist-title mb-3">Login Required</h2>
                                <p class="empty-wishlist-message mb-4">Please log in to view your wishlist and save your favorite luxury items.</p>
                                <a href="/login" class="btn btn-luxury btn-lg">Login</a>
                                <p class="mt-3">Don't have an account? <a href="/register" class="text-luxury">Register here</a></p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        {{/if}}
    {{/if}}

</main>


    <footer>
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <div class="footer-widget">
                        <h3>About LUXE</h3>
                        <p>LUXE is a premier destination for high-end furniture and home decor, offering exquisite pieces that blend style, comfort, and quality.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="footer-widget">
                        <h3>Quick Links</h3>
                        <ul>
                            <li><a href="/">Home</a></li>
                            <li><a href="/shop">Shop</a></li>
                            <li><a href="/about">About Us</a></li>
                            <li><a href="/contact">Contact</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="footer-widget">
                        <h3>Connect With Us</h3>
                        <ul class="social-icons">
                            <li><a href="#"><i class="fab fa-facebook-f"></i></a></li>
                            <li><a href="#"><i class="fab fa-instagram"></i></a></li>
                            <li><a href="#"><i class="fab fa-pinterest-p"></i></a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>