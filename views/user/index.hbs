                    <i class="fas fa-shopping-cart"></i>
                    <span class="cart-count"></span>
                </a>
            </div>
        </div>
    </nav>

    <main>
        <section class="hero" style="background-image: url('path-to-your-hero-image.jpg'); background-size: cover; background-position: center; height: 80vh; display: flex; align-items: center; position: relative;">
            <div class="container">
                <div style="max-width: 600px; position: relative; z-index: 2;">
                    <h1 style="font-family: 'Playfair Display', serif; font-size: 48px; color: #fff; margin-bottom: 20px;">Elegant Living, Redefined</h1>
                    <p style="font-size: 18px; color: #fff; margin-bottom: 30px;">Discover our curated collection of luxury home decor and furniture.</p>
                    <a href="/shop" style="display: inline-block; background-color: #c0a080; color: #fff; padding: 12px 30px; text-decoration: none; font-weight: 600; transition: background-color 0.3s ease;">Shop Now</a>
                </div>
            </div>
            <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0,0,0,0.4);"></div>
        </section>

        <section class="product-area" style="padding: 80px 0; background-color: #fff;">
            <div class="container">
                <h2 style="font-family: 'Playfair Display', serif; font-size: 36px; text-align: center; margin-bottom: 50px;">Our Products</h2>
                <div class="row">
                    <div class="col-xl-12">
                        <div class="product-tab-content">
                            <div class="tab-content" id="myTabContent">
                                <div class="tab-pane fade show active" id="home" role="tabpanel" aria-labelledby="home-tab">
                                    <div class="product-slider owl-carousel">
                                        {{#each firstPartProducts}}
                                        <div class="pro-item">
                                            <div class="product-wrapper mb-50">
                                                <div class="product-img mb-25">
                                                    <a href="/productinfo?q={{this._id}}">
                                                        <img src="{{this.imageUrls.[0]}}" alt="">
                                                        <img class="secondary-img" src="{{this.imageUrls.[2]}}" alt="">
                                                    </a>
                                                    <div class="product-action text-center">
                                                        <a href="#" title="Shopping Cart">
                                                            <i class="flaticon-shopping-cart"></i>
                                                        </a>
                                                        <a href="#" title="Quick View">
                                                            <i class="flaticon-eye"></i>
                                                        </a>
                                                        <a href="#" data-toggle="tooltip" data-placement="right" title="Compare">
                                                            <i class="flaticon-compare"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                                <div class="product-content">
                                                    <div class="pro-cat mb-10">
                                                        <a href="shop.html">{{this.brand.name}}</a>
                                                    </div>
                                                    <h4>
                                                        <a href="/productdetail/{{this._id}}">{{this.name}}</a>
                                                    </h4>
                                                    <div class="product-meta">
                                                        <div class="pro-price">
                                                            <span>₹{{this.price}}</span>
                                                            <span class="old-price">₹{{this.oldprice}}</span>
                                                        </div>
                                                    </div>
                                                    <div class="product-wishlist">
                                                        <a href="#"><i class="far fa-heart" title="Wishlist"></i></a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        {{/each}}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="newsletter" style="background-color: #1c1c1c; color: #fff; padding: 60px 0;">
            <div class="container" style="text-align: center;">
                <h2 style="font-family: 'Playfair Display', serif; font-size: 36px; margin-bottom: 20px;">Join Our Newsletter</h2>
                <p style="font-size: 18px; margin-bottom: 30px;">Stay updated with our latest collections and exclusive offers.</p>
                <form style="max-width: 500px; margin: 0 auto; display: flex;">
                    <input type="email" placeholder="Enter your email" style="flex-grow: 1; padding: 12px; border: none; font-size: 16px;">
                    <button type="submit" style="background-color: #c0a080; color: #fff; border: none; padding: 12px 30px; font-size: 16px; cursor: pointer; transition: background-color 0.3s ease;">Subscribe</button>
                </form>
            </div>
