        }
        .product-wrapper {
            background-color: #fff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            transition: transform 0.3s ease;
        }
        .product-wrapper:hover {
            transform: translateY(-5px);
        }
        .product-img {
            position: relative;
