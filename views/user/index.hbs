<body>
    <nav class="navbar">
        <div class="container" style="display: flex; justify-content: space-between; align-items: center;">
            <div class="logo">
                <a href="/">LUXE</a>
            </div>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/sale">Sale</a></li>
                <li><a href="/shop">Shop</a></li>
                <li><a href="/wishlist">Wishlist</a></li>
                <li><a href="/showCart">Cart</a></li>
            </ul>
