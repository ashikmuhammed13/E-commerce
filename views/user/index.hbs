            transform: scale(1.05);
        }
        .product-card .card-img-top {
            height: 300px; /* Fixed height for product images */
            object-fit: cover;
        }
        .different-banner {
            background-size: cover;
            background-position: center;
            padding: 100px 0;
            position: relative;
            color: white;
        }
        .different-banner::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0,0,0,0.6);
        }
        .brand-section {
            padding: 50px 0;
            background-color: #f8f9fa;
        }
        .brand-logo {
            max-width: 100px;
            height: 100px; /* Fixed height for brand logos */
            object-fit: contain;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    {{>header}}

    <!-- Banner Carousel -->
    <div id="bannerCarousel" class="carousel slide">
        <div class="carousel-inner">
            {{#each banners}}
            <div class="carousel-item {{#if @first}}active{{/if}}">
                <div class="banner-slide" style="background-image: url('/uploads/{{this.bgimage}}');">
                    <div class="banner-overlay"></div>
                    <div class="banner-content">
                        <h1 class="display-4 mb-4">{{this.maintext}}</h1>
                        <p class="lead mb-4">{{this.description}}</p>
                        <button class="btn btn-light btn-lg">Shop Now</button>
                    </div>
                    <div class="bg-text">{{this.bgtext}}</div>
                </div>
            </div>
            {{/each}}
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
    <br><br>
<h2 class="text-center mb-5">Our Signature Collection</h2>
    <!-- Product Cards -->
<section class="py-5 bg-light">
        <div class="container">
            
            <div class="row g-6">
                {{#each firstPartProducts}}
                <div class="col-6 col-md-3">
                    <div class="card product-card h-100">
                        <a href="/productdetail/{{this._id}}">
                            <img src="{{this.imageUrls.[0]}}" class="card-img-top" alt="{{this.name}}">
                        </a>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">{{this.name}}</h5>
                            {{!-- <p class="card-text mt-auto">₹{{this.price.toLocaleString()}}</p> --}}
                            <a href="/productinfo?q={{this._id}}" class="btn btn-dark mt-2">Add to Cart</a>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
    </section>

    <!-- Different Design Banner -->
  <section class="different-banner" style="background-image: url('https://images.unsplash.com/photo-1490114538077-0a7f8cb49891?ixlib=rb-1.2.1&auto=format&fit=crop&w=1600&q=80');">
        <div class="container position-relative">
            <div class="row justify-content-center">
                <div class="col-md-8 text-center">
                    <h2 class="display-4 mb-4">Luxury Redefined</h2>
                    <p class="lead mb-4">Experience the epitome of elegance with our exclusive collections.</p>
                    <button class="btn btn-light btn-lg">View Lookbook</button>
                </div>
            </div>
        </div>
    </section>

    <!-- Brand Section -->
    <section class="brand-section">
        <div class="container">
            <h2 class="text-center mb-5">Our Brands</h2>
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-4 justify-content-center">
                {{#each brands}}
                <div class="col text-center">
                    <img src="/uploads/{{this.logo}}" alt="{{this.name}}" class="brand-logo img-fluid">
                    <p class="mt-2">{{this.name}}</p>
                </div>
                {{/each}}
            </div>
        </div>
    </section>

    <!-- Featured Products -->
    <h2 class="text-center mb-5">Featured Products</h2>
    <section class="py-5 bg-light">
        <div class="container">
            
            <div class="row g-6">
                {{#each remainingProducts}}
                <div class="col-6 col-md-3">
                    <div class="card product-card h-100">
                        <a href="/productdetail/{{this._id}}">
                            <img src="{{this.imageUrls.[0]}}" class="card-img-top" alt="{{this.name}}">
                        </a>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">{{this.name}}</h5>
                            {{!-- <p class="card-text mt-auto">₹{{this.price.toLocaleString()}}</p> --}}
                            <a href="/productinfo?q={{this._id}}" class="btn btn-dark mt-2">Add to Cart</a>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
    </section>

    {{>footer}}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

