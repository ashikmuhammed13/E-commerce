<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luxury Shopping - LUXE</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f8f5f2;
            color: #333;
        }
        .container {
            max-width: 1200px;
            width: 100%;
            padding-left: 20px;
            padding-right: 20px;
            margin-left: auto;
            margin-right: auto;
        }
        .breadcrumb-area {
            background-color: #1c1c1c;
            padding: 60px 0;
            position: relative;
        }
        .breadcrumb-text h1 {
            color: #c0a080;
            font-family: 'Playfair Display', serif;
            font-size: 48px;
            margin-bottom: 10px;
        }
        .breadcrumb-menu {
            padding: 0;
            margin: 0;
            list-style: none;
        }
        .breadcrumb-menu li {
            display: inline-block;
            color: #fff;
            font-size: 14px;
        }
        .breadcrumb-menu li:not(:last-child)::after {
            content: '/';
            margin: 0 5px;
            color: #c0a080;
        }
        .breadcrumb-menu li a {
            color: #c0a080;
            text-decoration: none;
        }
        .shop-area {
            padding: 80px 0;
        }
        .sidebar-shop {
            background-color: #fff;
            padding: 30px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        }
        .shop-widget {
            margin-bottom: 40px;
        }
        .shop-widget h3 {
            font-family: 'Playfair Display', serif;
            color: #1c1c1c;
            font-size: 24px;
            margin-bottom: 20px;
        }
        .shop-widget ul {
            list-style: none;
            padding: 0;
        }
        .shop-widget ul li {
            margin-bottom: 10px;
        }
        .shop-widget ul li a {
            color: #333;
            text-decoration: none;
            transition: color 0.3s ease;
        }
        .shop-widget ul li a:hover {
            color: #c0a080;
        }
        .price-filter {
            margin-top: 20px;
        }
        .product-wrapper {
            background-color: #fff;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            margin-bottom: 30px;
        }
        .product-wrapper:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.12);
        }
        .product-img {
            position: relative;
            overflow: hidden;
        }
        .product-img img {
            width: 100%;
            transition: all 0.5s ease;
        }
        .product-img:hover img.secondary-img {
            opacity: 1;
        }
        .product-img img.secondary-img {
            position: absolute;
            top: 0;
            left: 0;
            opacity: 0;
            transition: all 0.5s ease;
        }
        .product-action {
            position: absolute;
            bottom: -50px;
            left: 0;
            right: 0;
            text-align: center;
            transition: all 0.5s ease;
        }
        .product-wrapper:hover .product-action {
            bottom: 20px;
        }
        .product-action a {
            display: inline-block;
            width: 40px;
            height: 40px;
            line-height: 40px;
            background-color: #fff;
            color: #1c1c1c;
            border-radius: 50%;
            margin: 0 5px;
            transition: all 0.3s ease;
        }
        .product-action a:hover {
            background-color: #c0a080;
            color: #fff;
        }
        .product-content {
            padding: 20px;
        }
        .pro-cat {
            margin-bottom: 10px;
        }
        .pro-cat a {
            color: #c0a080;
            text-decoration: none;
        }
        .product-content h4 {
            font-family: 'Playfair Display', serif;
            margin-bottom: 10px;
        }
        .product-content h4 a {
            color: #1c1c1c;
            text-decoration: none;
            transition: color 0.3s ease;
        }
        .product-content h4 a:hover {
            color: #c0a080;
        }
        .product-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .pro-price {
            color: #c0a080;
            font-weight: 600;
        }
        .old-price {
            text-decoration: line-through;
            color: #999;
            margin-left: 10px;
        }
        .shop-tab {
            margin-bottom: 30px;
        }
        .shop-tab .nav-link {
            color: #1c1c1c;
            border: none;
            padding: 10px 15px;
            background-color: #f8f5f2;
            margin-right: 10px;
            transition: all 0.3s ease;
        }
        .shop-tab .nav-link.active,
        .shop-tab .nav-link:hover {
            background-color: #c0a080;
            color: #fff;
        }
        .pro-filter select {
            border: 1px solid #c0a080;
            padding: 10px 15px;
            color: #1c1c1c;
            background-color: transparent;
            appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 10px center;
            background-size: 1em;
        }
    </style>
</head>
<body>
    {{>header}}
    <main>
        <div class="breadcrumb-area">
            <div class="container">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="breadcrumb-text text-center">
                            <h1>Luxury Collection</h1>
                            <ul class="breadcrumb-menu">
                                <li><a href="/">Home</a></li>
                                <li><span>Shop</span></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <section class="shop-area pt-100 pb-100">
            <div class="container">
                <div class="row">
                    <div class="col-xl-3 col-lg-4">
                        <div class="sidebar-shop">
                            <div class="shop-widget">
                                <h3 class="shop-title">Search</h3>
                                <form action="#" class="shop-search">
                                    <input type="text" placeholder="Search products...">
                                    <button type="submit"><i class="fa fa-search"></i></button>
                                </form>
                            </div>
                            <div class="shop-widget">
                                <h3 class="shop-title">Filter by Price</h3>
                                <div class="price-filter">
                                    <div id="slider-range"></div>
                                    <input type="text" id="amount" readonly>
                                </div>
                            </div>
                            <div class="shop-widget">
                                <h3 class="shop-title">Categories</h3>
                                <ul class="shop-link">
                                    <li><a href="#"><i class="far fa-square"></i> Clothing</a></li>
                                    <li><a href="#"><i class="far fa-square"></i> Accessories</a></li>
                                    <li><a href="#"><i class="far fa-square"></i> Bags</a></li>
                                    <li><a href="#"><i class="far fa-square"></i> Shoes</a></li>
                                    <li><a href="#"><i class="far fa-square"></i> Jewelry</a></li>
                                </ul>
                            </div>
                            <div class="shop-widget">
                                <h3 class="shop-title">Brands</h3>
                                <ul class="shop-link">
                                    <li><a href="#"><i class="far fa-square"></i> Gucci</a></li>
                                    <li><a href="#"><i class="far fa-square"></i> Louis Vuitton</a></li>
                                    <li><a href="#"><i class="far fa-square"></i> Chanel</a></li>
                                    <li><a href="#"><i class="far fa-square"></i> Hermès</a></li>
                                    <li><a href="#"><i class="far fa-square"></i> Prada</a></li>
                                </ul>
                            </div>
                            <div class="shop-widget">
                                <h3 class="shop-title">Top Rated Products</h3>
                                <ul class="shop-sidebar-product">
                                    <li>
                                        <div class="side-pro-img">
                                            <a href="#"><img src="img/product/latest/shop-rsp3.jpg" alt=""></a>
                                        </div>
                                        <div class="side-pro-content">
                                            <div class="side-pro-rating">
                                                <i class="fas fa-star"></i>
                                                <i class="fas fa-star"></i>
                                                <i class="fas fa-star"></i>
                                                <i class="fas fa-star"></i>
                                                <i class="fas fa-star"></i>
                                            </div>
                                            <h5><a href="#">Exclusive Handbag</a></h5>
                                            <div class="side-pro-price">
                                                <span>$119.00 USD</span>
                                            </div>
                                        </div>
                                    </li>
                                    <!-- Add more top rated products here -->
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-9 col-lg-8">
                        <div class="row mb-10">
                            <div class="col-xl-5 col-lg-6 col-md-6">
                                <div class="product-showing mb-40">
                                    <p>Showing 1–12 of 30 results</p>
                                </div>
                            </div>
                            <div class="col-xl-7 col-lg-6 col-md-6">
                                <div class="shop-tab f-right">
                                    <ul class="nav text-center" id="myTab" role="tablist">
                                        <li class="nav-item">
                                            <a class="nav-link active" id="home-tab" data-toggle="tab" href="#home" role="tab" aria-controls="home"
                                                aria-selected="true"><i class="fas fa-th-large"></i></a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" id="profile-tab" data-toggle="tab" href="#profile" role="tab" aria-controls="profile"
                                                aria-selected="false"><i class="fas fa-list-ul"></i></a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="pro-filter mb-40 f-right">
                                    <form action="#">
                                        <select name="pro-filter" id="pro-filter">
                                            <option value="1">Sort by latest</option>
                                            <option value="2">Sort by popularity</option>
                                            <option value="3">Sort by rating</option>
                                            <option value="4">Sort by price: low to high</option>
                                            <option value="5">Sort by price: high to low</option>
                                        </select>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            {{#each shops}}
                            <div class="col-xl-4 col-lg-6 col-md-6">
                                <div class="product-wrapper mb-50">
                                    <div class="product-img mb-25">
                                        <a href="/productinfo/{{this._id}}">
                                            <img src="{{this.imageUrls.[0]}}" alt="">
                                            <img class="secondary-img" src="{{this.imageUrls.[2]}}" alt="">
                                        </a>
                                        <div class="product-action text-center">
                                            <a href="#" title="Shopping Cart">
                                                <i class="flaticon-shopping-cart"></i>
                                            </a>
                                            <a href="#" title="Quick View">
                                                <i class="flaticon-eye"></i>
                                            </a>
                                            <a href="#" data-toggle="tooltip" data-placement="right" title="Compare">
                                                <i class="flaticon-compare"></i>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="product-content pr-0">
                                        <div class="pro-cat mb-10">
                                            <a href="shop.html">{{this.brand.name}}</a>
                                        </div>
                                        <h4>
                                            <a href="/productdetail/{{this._id}}">{{this.name}}</a>
                                        </h4>
                                        <div class="product-meta">
                                            <div class="pro-price">
                                                <span>₹{{this.price}}</span>
                                                <span class="old-price">₹{{this.oldprice}}</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {{/each}}
                        </div>
                        <div class="row mt-50">
                            <div class="col-xl-12">
                                <div class="basic-pagination basic-pagination-2 text-center">
                                    <ul>
                                        <li><a href="#"><i class="fas fa-angle-double-left"></i></a></li>
                                        <li><a href="#">01</a></li>
                                        <li class="active"><a href="#">02</a></li>
                                        <li><a href="#">03</a></li>
                                        <li><a href="#"><i class="fas fa-ellipsis-h"></i></a></li>
                                        <li><a href="#"><i class="fas fa-angle-double-right"></i></a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

{{>footer}}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>
    <script>
$(document).ready(function() {
    // Price range slider
    $("#slider-range").slider({
        range: true,
        min: 0,
        max: 10000,
        values: [0, 5000],
        slide: function(event, ui) {
            $("#amount").val("₹" + ui.values[0] + " - ₹" + ui.values[1]);
        }
    });
    $("#amount").val("₹" + $("#slider-range").slider("values", 0) +
        " - ₹" + $("#slider-range").slider("values", 1));

    // Product hover effect
    $(".product-wrapper").hover(
        function() {
            $(this).find(".product-action").stop().animate({bottom: "20px"}, 300);
        },
        function() {
            $(this).find(".product-action").stop().animate({bottom: "-50px"}, 300);
        }
    );

    // Quick view functionality (you'll need to implement this)
    $(".product-action a[title='Quick View']").on("click", function(e) {
        e.preventDefault();
        // Implement quick view logic here
        console.log("Quick view clicked");
    });

    // Add to cart functionality (you'll need to implement this)
    $(".product-action a[title='Shopping Cart']").on("click", function(e) {
        e.preventDefault();
        // Implement add to cart logic here
        console.log("Add to cart clicked");
    });

    // Compare functionality (you'll need to implement this)
    $(".product-action a[title='Compare']").on("click", function(e) {
        e.preventDefault();
        // Implement compare logic here
        console.log("Compare clicked");
    });

    // Filter products (you'll need to implement this)
    $("#pro-filter").on("change", function() {
        // Implement filter logic here
        console.log("Filter changed to: " + $(this).val());
    });

    // Search functionality (you'll need to implement this)
    $(".shop-search").on("submit", function(e) {
        e.preventDefault();
        var searchTerm = $(this).find("input[type='text']").val();
        // Implement search logic here
        console.log("Search for: " + searchTerm);
    });
});
</script>
</body>
</html>